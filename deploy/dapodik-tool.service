[Unit]
Description=Dapodik Tool SMANTI
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=dapodik
Group=dapodik
WorkingDirectory=/opt/dapodik-tool
EnvironmentFile=/etc/dapodik-tool/env
ExecStart=/opt/dapodik-tool/dapodik-tool serve
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/dapodik-tool/data /opt/dapodik-tool/backup
TimeoutStopSec=15

[Install]
WantedBy=multi-user.target
