# Salin ke /etc/dapodik-tool/env dan isi nilainya.
APP_ENV=production
APP_ADDR=127.0.0.1:8000
APP_NAME=SMANTI Tools
DATABASE_PATH=/opt/dapodik-tool/data/app.db

# Wajib di production. Buat dengan: openssl rand -hex 32
SESSION_SECRET=ganti-dengan-32-byte-hex
# Opsional. Kunci enkripsi kredensial Dapodik yang disimpan admin.
# Jika kosong, diturunkan dari SESSION_SECRET. Mengubahnya membuat
# cookie/token tersimpan tidak bisa didekripsi (admin harus menyimpan ulang).
# CREDENTIALS_KEY=ganti-dengan-32-byte-hex-lain
SESSION_COOKIE_SECURE=1
TRUST_PROXY=1

# Nilai awal form; guru tetap bisa mengubah di halaman.
DEFAULT_BASE_URL=https://dapodik2.sman3palu.sch.id
DEFAULT_SEKOLAH_ID=777c554f-6a9d-4f56-af30-3a16deea592f
DEFAULT_NPSN=40203612

LOG_LEVEL=info

# Opsional: admin pertama otomatis dibuat saat database masih kosong.
# BOOTSTRAP_ADMIN_USERNAME=admin
# BOOTSTRAP_ADMIN_PASSWORD=password-kuat
# BOOTSTRAP_ADMIN_NAME=Administrator
